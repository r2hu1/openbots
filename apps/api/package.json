{
  "name": "api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun ./dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --outfile=dist/index.js --external:hono --external:@hono/node-server --external:better-auth --external:resend --external:drizzle-orm --external:postgres --external:ioredis --external:@composio/core --external:undici --external:@daytona/sdk --external:ai",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test-agent-runtime.ts",
    "trigger:dev": "bunx trigger.dev@latest dev",
    "trigger:deploy": "bunx trigger.dev@latest deploy"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.88",
    "@ai-sdk/google": "^4.0.105",
    "@ai-sdk/openai": "^4.0.102",
    "@composio/core": "^0.27.0",
    "@composio/vercel": "^0.13.0",
    "@daytona/sdk": "^0.226.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@openbots/api-contract": "workspace:*",
    "@openbots/db": "workspace:*",
    "@trigger.dev/sdk": "4.8.2",
    "ai": "^7.0.153",
    "better-auth": "^1.7.12",
    "docx": "^9.14.0",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "hono": "^4.13.13",
    "html-to-docx": "^1.8.0",
    "ioredis": "^6.0.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "2.4.5",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "tslib": "^2.8.1",
    "undici": "^8.12.3",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@openbots/typescript-config": "workspace:*",
    "@trigger.dev/build": "4.8.2",
    "@types/node": "^26.6.5",
    "@types/pdf-parse": "^1.1.5",
    "@types/web-push": "^3.6.4",
    "typescript": "^7.0.2"
  }
}